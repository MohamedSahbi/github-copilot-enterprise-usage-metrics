# Copy to terraform.tfvars (git-ignored) and adjust. Non-secret values only; secrets live in Key Vault.
environment = "dev"
location    = "westeurope"
name_prefix = "cmp"

# Optional: deploy into a pre-existing resource group.
# existing_resource_group_name = "rg-existing"

organization = {
  enterprise_slug    = "example-enterprise"
  organizations      = ["example-org"]
  login_suffix       = "_example"
  group_prefix       = "copilot-"
  directory_provider = "entra"
  entra_tenant_id    = "00000000-0000-0000-0000-000000000000"
}

# Nonsecret GitHub App identifier used only by metrics ingestion. The private key stays in Key Vault.
github_app_id = "123456"
# Optional inclusive metrics backfill start (YYYY-MM-DD); omit to request no historical fetch.
# backfill_from = "2025-10-10"

# Sign-in identifiers are placeholders. OAuth secrets are created in Key Vault using the secret_names output.
auth_trust_host                    = false
trusted_forwarding_ingress         = false
auth_microsoft_entra_id_id         = "00000000-0000-0000-0000-000000000000"
auth_github_id                     = "REPLACE_WITH_CLIENT_ID"
access_break_glass_group_id        = ""
access_permission_freshness_minutes = 5
access_no_access_message           = "You do not currently have permission to use this portal."
access_request_url                 = ""
access_contact                     = ""
directory_department_attribute     = ""
directory_business_area_attribute  = ""
stale_data_threshold_hours         = 36
per_user_detail_enabled            = false

modules = {
  ai_credits    = false
  budget_lookup = false
  feedback      = true
}

# Move raw archive blobs to Cool after this many months; retained without deletion.
raw_archive_cool_after_months = 13

# Required unless existing_sql is set: the Entra user, group, or managed identity (passed in, not created) that administers the demo SQL server.
sql_admin = {
  login_username = "example-sql-admins"
  object_id      = "00000000-0000-0000-0000-000000000000"
}

alert_emails = ["team@example.com"]

# Development only: skip private endpoints. Keep true for test and prod.
private_endpoints_enabled = false

# Synthetic documentation-only IPv4. Supply every app's possible outbound IPs in private environment tfvars.
key_vault_allowed_ipv4_addresses = ["192.0.2.10"]

# Optional Entra USER object IDs for secret management; supply real IDs only in private config.
key_vault_operator_object_ids = []

network = {
  mode = "create"
}
