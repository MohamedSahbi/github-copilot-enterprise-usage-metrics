# Copy to terraform.tfvars (git-ignored) and adjust. Non-secret values only; secrets live in Key Vault.
environment = "dev"
location    = "westeurope"
name_prefix = "cmp"

# Optional: deploy into a pre-existing resource group.
# existing_resource_group_name = "rg-existing"

organization = {
  enterprise_slug    = "example-enterprise"
  organizations      = ["example-org"]
  login_suffix       = "_example"
  group_prefix       = "copilot-"
  directory_provider = "entra"
  entra_tenant_id    = "00000000-0000-0000-0000-000000000000"
}

modules = {
  ai_credits    = false
  budget_lookup = false
  feedback      = true
}

# Move raw archive blobs to Cool after this many months; retained without deletion.
raw_archive_cool_after_months = 13

# Required unless existing_sql is set: the Entra user, group, or managed identity (passed in, not created) that administers the demo SQL server.
sql_admin = {
  login_username = "example-sql-admins"
  object_id      = "00000000-0000-0000-0000-000000000000"
}

alert_emails = ["team@example.com"]

# Development only: skip private endpoints. Keep true for test and prod.
private_endpoints_enabled = false

network = {
  mode = "create"
}
