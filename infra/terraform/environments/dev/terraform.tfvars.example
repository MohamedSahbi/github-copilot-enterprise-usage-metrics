# Copy to terraform.tfvars (git-ignored) and adjust. Non-secret values only; secrets live in Key Vault.
location    = "westeurope"
name_prefix = "cmp"

organization = {
  enterprise_slug    = "example-enterprise"
  organizations      = ["example-org"]
  login_suffix       = "_example"
  group_prefix       = "copilot-"
  directory_provider = "entra"
  entra_tenant_id    = "00000000-0000-0000-0000-000000000000"
}

modules = {
  ai_credits    = false
  budget_lookup = false
  feedback      = true
}

alert_emails = ["team@example.com"]

# Development only: skip private endpoints. Keep true for test and prod.
private_endpoints_enabled = false

network = {
  mode = "create"
}
