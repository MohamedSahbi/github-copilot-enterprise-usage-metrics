# Names are the deployment contract; replace placeholders privately. Secrets are Key Vault references at runtime.
AUTH_SECRET=REPLACE_WITH_KEY_VAULT_REFERENCE
AUTH_TRUST_HOST=true
AUTH_MICROSOFT_ENTRA_ID_ID=REPLACE_WITH_CLIENT_ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=REPLACE_WITH_KEY_VAULT_REFERENCE
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_ID
AUTH_GITHUB_ID=REPLACE_WITH_CLIENT_ID
AUTH_GITHUB_SECRET=REPLACE_WITH_KEY_VAULT_REFERENCE
SQL_SERVER=REPLACE_WITH_SQL_SERVER_FQDN
SQL_DATABASE=REPLACE_WITH_DATABASE_NAME
AZURE_CLIENT_ID=REPLACE_WITH_MANAGED_IDENTITY_CLIENT_ID
ACCESS_BREAK_GLASS_GROUP_ID=
ACCESS_PERMISSION_FRESHNESS_MINUTES=5
ACCESS_NO_ACCESS_MESSAGE=You do not currently have permission to use this portal.
ACCESS_REQUEST_URL=
ACCESS_CONTACT=
DIRECTORY_PROVIDER=entra
DIRECTORY_DEPARTMENT_ATTRIBUTE=
DIRECTORY_BUSINESS_AREA_ATTRIBUTE=
STALE_DATA_THRESHOLD_HOURS=36
PER_USER_DETAIL_ENABLED=false
