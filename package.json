{
  "name": "github-copilot-enterprise-usage-metrics",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "portal",
    "functions",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "globals": "^17.13.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
