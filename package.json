{
  "name": "github-copilot-enterprise-usage-metrics",
  "version": "0.2.7",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "portal",
    "functions",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/contracts/oracle/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db/migrate-cli.ts",
    "db:fixtures": "tsx scripts/stack/stack.ts fixtures",
    "stack:up": "tsx scripts/stack/stack.ts up",
    "stack:down": "tsx scripts/stack/stack.ts down",
    "test:sql": "RUN_SQL_TESTS=1 vitest run scripts/contracts/sql-container.test.ts",
    "test:smoke": "playwright test e2e/smoke",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "globals": "^17.13.0",
    "mssql": "^12.7.11",
    "postgrator": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
